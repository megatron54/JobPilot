# JobPilot Configuration
# These are defaults for Docker Compose. No changes needed for docker compose up.

# LLM (Ollama - runs locally, zero cost)
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.7

# Server
HOST=0.0.0.0
PORT=8000

# Data directories
DATA_DIR=/app/data
CV_DIR=/app/data/cvs
JOBS_DIR=/app/data/jobs
OUTPUTS_DIR=/app/data/outputs

# Default language (es, en, fr, de, pt...)
DEFAULT_LANGUAGE=es
